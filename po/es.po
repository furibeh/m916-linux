#: m916/cli.py
#, python-format
msgid ""
"a bare NAME is NAME.json in %s; a path with '/' or ending in .json is used "
"as given. A profile may leave sections out; loading it only writes the "
"fields that change (see docs/PROFILES.md)"
msgstr ""
"un NAME sin ruta es NAME.json en %s; una ruta con '/' o terminada en .json "
"se usa tal cual. Un perfil puede omitir secciones; al cargarlo solo se "
"escriben los campos que cambian (ver docs/PROFILES.md)"

#: m916/cli.py
