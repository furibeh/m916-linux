"key:ctrl+c, key:mute; see 'keys')"
msgstr ""
"acciones: %s, fire:INTERVALO_MS:DISPAROS (cada clic, INTERVALO_MS pulsado e "
"INTERVALO_MS suelto; 0 disparos = mientras se pulse), dpi-lock:DPI, "
"key:COMBINACIÓN (p. ej. key:ctrl+c, key:mute; ver 'keys')"

