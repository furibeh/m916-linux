"could not go back to slot %(original)d (%(error)s); the mouse stayed on slot "
"%(slot)d"
msgstr ""
"no se pudo volver a la ranura %(original)d (%(error)s); el ratón se quedó en "
"la ranura %(slot)d"

#: m916/protocol.py
#, python-format
msgid ""
"no response to command 0x%(cmd)02x at 0x%(addr)04x (mouse asleep or off? "
"move it and try again)"
msgstr ""
"sin respuesta al comando 0x%(cmd)02x en 0x%(addr)04x (¿ratón dormido o "
"apagado? muévelo y vuelve a intentarlo)"

#: m916/protocol.py
msgid "receiver"
msgstr "receptor"

#: m916/protocol.py
